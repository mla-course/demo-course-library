        [:rp " ("]
        [:rt {:lang "ja-Latn", :class "lang-ja-Latn"} "konnichiwa"]
        [:rp ", "]
        [:rt {:lang "en", :class "lang-en"} "hello"]
        [:rp ")"]]
       " for the rest of the day."]
